{
  "name": "crash-mdt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/server/index.ts",
    "dev:web": "vite",
    "build": "prisma generate && tsc -p tsconfig.server.json && vite build",
    "start": "node --enable-source-maps dist/server/apps/server/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint apps packages tests prisma.config.ts vite.config.ts playwright.config.ts",
    "format": "prettier --write apps packages tests *.ts eslint.config.js",
    "migrate": "prisma migrate deploy",
    "account": "node --enable-source-maps dist/server/apps/server/account-cli.js",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "@hocuspocus/provider": "4.8.0",
    "@hocuspocus/server": "4.8.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-collaboration": "3.33.1",
    "@tiptap/extension-collaboration-caret": "3.33.1",
    "@tiptap/extension-image": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "@tiptap/y-tiptap": "3.3.0",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "lib0": "0.2.120",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "ws": "8.22.2",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8"
  }
}
