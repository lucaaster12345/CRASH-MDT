{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "sourceMap": true, "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["apps", "packages", "tests", "prisma.config.ts", "vite.config.ts", "playwright.config.ts"]
}
